{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__Cloudflare_API__whoami",
      "mcp__Cloudflare_API__search",
      "mcp__Cloudflare_API__docs"
    ],
    "ask": [
      "mcp__Cloudflare_API__execute"
    ],
    "deny": [
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npm run deploy:*)",
      "Bash(wrangler secret:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)"
    ]
  }
}
